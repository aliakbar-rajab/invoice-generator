/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "invoice-telegram",
	"main": "src/index.js",
	"compatibility_date": "2026-08-20",
	// Required by @cloudflare/puppeteer: its globalPatcher imports
	// "node:buffer" at module scope to install globalThis.Buffer.
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	/**
	 * layoutInvoicePages (src/lib/invoiceLayout.js) is shipped INTO the render
	 * browser by page.evaluate, which serialises it with Function.toString().
	 * esbuild's keep-names pass rewrites named inner functions as
	 * `__name(fn, "fn")` — and `__name` is a module-scope helper that does not
	 * exist in that page, so the serialised copy throws "__name is not
	 * defined" the moment it runs. Nothing here needs the original .name.
	 * https://esbuild.github.io/api/#keep-names
	 */
	"keep_names": false,
	"upload_source_maps": true,
	/**
	 * Static Assets (invoice logos, stamps, embedded font — read at runtime via
	 * env.ASSETS.fetch() and inlined as data: URIs into the PDF HTML so the
	 * headless browser needs no network access to render it)
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	"assets": {
		"directory": "./public/",
		"binding": "ASSETS",
		"not_found_handling": "none"
	},
	/**
	 * Durable Objects — one InvoiceSession instance per Telegram chat, holding
	 * the conversation's draft invoice. This is the durable state store; the
	 * Worker itself never keeps conversation state in memory.
	 * https://developers.cloudflare.com/durable-objects/
	 */
	"durable_objects": {
		"bindings": [
			{ "name": "INVOICE_SESSION", "class_name": "InvoiceSession" },
			{ "name": "INVOICE_COUNTER", "class_name": "InvoiceCounter" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["InvoiceSession", "InvoiceCounter"] }
	],
	/**
	 * Browser Rendering — headless Chromium used to turn the invoice HTML
	 * (built from the desktop app's own print design) into the final A4 PDF.
	 * https://developers.cloudflare.com/browser-rendering/
	 */
	"browser": {
		"binding": "BROWSER"
	}
}